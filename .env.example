# Copy to .env.local and fill in. Set the same keys in Vercel → Project → Settings → Environment Variables (Production).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Periodic cron: /api/cron/periodic-tasks — generate e.g. openssl rand -hex 32
CRON_SECRET=

# Optional: only when testing curl AGAINST A VERCEL-DEPLOYED URL that has
# "Deployment Protection" + "Protection bypass for automation" enabled.
# Use the same secret as in Vercel (may match VERCEL_AUTOMATION_BYPASS_SECRET on that deployment).
# NOT required for localhost cron curl.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# VPS (Hostinger etc.): see Reference Docs/PERIODIC_TASKS_CRON_HOSTINGER_VPS.md — same vars on the server;
# schedule /api/cron/periodic-tasks with Linux cron + curl (vercel.json is not used there).
